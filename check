#!/bin/sh
# Every check that needs no browser, in one command. .githooks/pre-push and CI both run it; so can you.
# Node tests (about 190 s, measured 2026-10-25: relay-link 117 s and marks-store 59 s are their mutant loops) always; the JVM tier when Java changed and always in CI; the browser tier for the
# pages this push changed (0 s to about 15 min), on the pushing machine.
# A check that cannot run is not a pass: if nothing ran, the script exits 2.
set -e
cd "$(dirname "$0")"
ran=0
run() { echo "== $*"; "$@"; ran=$((ran + 1)); }
run node scripts/parse-check.cjs
run node scripts/rmssd-parity.test.js
run node scripts/junk-parity.test.cjs
run node scripts/csv-format.test.cjs
run node scripts/segment-format.test.cjs
run node scripts/day-boundary.test.cjs
run node scripts/avg-stats.test.cjs
run node scripts/auth-trace.test.cjs
run node scripts/auth-api.test.mjs
run node scripts/relay-server.test.mjs
run node scripts/bubble-tokens.test.cjs
run node scripts/engine-boundary.test.cjs
run node scripts/bundle-refs.test.cjs
run node scripts/docs-truth.test.cjs
run node scripts/lifecycle-state.test.cjs
run node scripts/lifecycle-deadline.test.cjs
run node scripts/demo-synthetic.test.cjs
run node scripts/marks-store.test.cjs
run node scripts/relay-link.test.cjs
run node scripts/recorder.test.cjs
run node scripts/day-gaps.test.cjs
run node scripts/session-dedup.test.cjs
run node scripts/row-epoch.test.cjs
run node scripts/catch-floor.mjs
run node scripts/coverage.mjs
run node scripts/section-map.mjs
run node scripts/personal-scan.mjs
# The JVM tier (compiles the real native Java, about 4 min) runs in CI always, and locally only when the
# push touches the Java or these tests (or origin/main is unknown).
if [ -n "$CI" ] || ! git rev-parse -q --verify origin/main >/dev/null \
   || git diff --name-only origin/main...HEAD | grep -qE '^mobile/android-overlay/|^scripts/jvm/'; then
  for t in scripts/jvm/run-*.cjs; do run node "$t"; done
else
  echo "== JVM tier skipped: no Java or scripts/jvm change since origin/main (CI runs it)"
fi
# The browser tier: headless Playwright checks for the files this push changed (scripts/browser-tier.mjs).
# The full tier needs the local ux-audit kit and real recordings, so it runs on the pushing machine. CI runs the
# monitor checks in their own workflow step (synthetic data only) and says so here instead of passing quietly.
if [ -n "$CI" ]; then
  echo "== browser tier: CI runs the monitor checks in its own step; the viewer checks run in the pre-push hook"
else
  run node scripts/browser-tier.mjs
fi
# The CLAUDE.md map checker is local-only (gitignored; the repo is public), so CI skips it.
if [ -f .claude/docmap.py ]; then run python .claude/docmap.py; fi
if [ "$ran" -eq 0 ]; then echo "check: nothing ran"; exit 2; fi
echo "check: all $ran passed"
