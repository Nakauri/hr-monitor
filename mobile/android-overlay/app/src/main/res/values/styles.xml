<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Post-splash theme. windowBackground is the dark aorti background
         so there's no white flash between the splash dismissing and the
         WebView drawing its first frame. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/aorti_icon_bg</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch theme. API 31+ uses the SplashScreen API (animated icon
         on dark background). Pre-API-31 (e.g. Galaxy S8 / Android 9)
         falls back to android:windowBackground, which now points at a
         layer-list drawable that paints the dark colour AND centres the
         aorti glyph — so older devices get branded launch frame instead
         of a black flash. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A0A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/aorti_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">#0A0A0A</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
