<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Our native HR session foreground service. Owns the session
             lifecycle notification so the process is kept alive + BLE
             callbacks keep firing when the screen is off. Replaces the
             @capawesome FGS plugin on the session path. -->
        <service
            android:name="com.nakauri.hrmonitor.NativeHrService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!-- @capawesome FGS plugin service — kept registered so the plugin
             itself loads without errors, but no longer used on the session
             path. Safe to remove once hr_monitor.html stops invoking
             HRMForegroundService.start on Capacitor. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <receiver
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.NotificationActionBroadcastReceiver"
            android:exported="false" />

        <!-- Periodic FGS-resurrection check. Fires every 15 min via
             setExactAndAllowWhileIdle and restarts the service if it died. -->
        <receiver
            android:name="com.nakauri.hrmonitor.HrServiceHeartbeatReceiver"
            android:exported="false" />

        <!-- The notification's Symptom action. Explicit intent only. -->
        <receiver
            android:name="com.nakauri.hrmonitor.SymptomReceiver"
            android:exported="false" />

        <!-- Floating HR overlay (Pulsoid-style). Hosts a WindowManager-attached
             View that displays live BPM above other apps. Requires the
             SYSTEM_ALERT_WINDOW permission; user-toggled via long-press on
             the widget in the app. -->
        <service
            android:name="com.nakauri.hrmonitor.FloatingOverlayService"
            android:exported="false" />

        <!-- Health Connect's privacy-policy target (exported: Health Connect starts it, or it shows no permission sheet). -->
        <activity
            android:name="com.nakauri.hrmonitor.HealthRationaleActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Android 14+ form of the same target; only the system holds START_VIEW_PERMISSION_USAGE. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.nakauri.hrmonitor.HealthRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The scan only finds straps, never location: Android 12+ then needs neither Location nor its switch. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <!-- Android 11 and older return no scan results without it; bleAccess asks for it there. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Health Connect sleep read (S65a). The client library is minSdk 26; HealthConnectPlugin checks SDK_INT >= 28. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
